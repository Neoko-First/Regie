# Copier ce fichier en `.env` (jamais commité). Valeurs de développement local.

# Environnement : development | test | production
NODE_ENV=development
# Port d'écoute de l'API (le front y accède via son proxy BFF, variable API_URL côté web)
PORT=4000
# PostgreSQL lancé par `pnpm db:up` (docker-compose.yml, port hôte 5433)
DATABASE_URL=postgresql://regie:regie@localhost:5433/regie?schema=public
# Origine du front : seule origine autorisée par CORS et par la vérification Origin (CSRF)
WEB_ORIGIN=http://localhost:3000
# Clé de signature des access tokens (HS256), 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=a-remplacer-par-une-cle-aleatoire-de-64-caracteres-hexadecimaux
# Préfixe sous lequel le navigateur voit l'API (proxy BFF du front)
PUBLIC_API_PREFIX=/api

# Mot de passe des comptes de développement créés par `pnpm db:seed` (jamais en production)
SEED_USER_PASSWORD=Regie-Dev-2026!
