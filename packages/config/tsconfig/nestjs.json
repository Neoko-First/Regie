{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "API NestJS (CommonJS via NodeNext, décorateurs)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": false
  }
}
